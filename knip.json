{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignore": [
		"shot.mjs",
		".agents/**"
	],
	"workspaces": {
		"apps/server": {
			"entry": [
				"tests/**/*.test.ts"
			],
			"project": [
				"src/**/*.ts",
				"tests/**/*.ts"
			]
		},
		"apps/web": {
			"project": [
				"src/**/*.{ts,svelte}",
				"tests/**/*.ts"
			],
			"ignoreDependencies": [
				"@fontsource/geist-sans",
				"@fontsource/geist-mono",
				"@fontsource/lora"
			]
		},
		"apps/app": {
			"entry": [
				"tests/**/*.test.ts"
			],
			"project": [
				"src/**/*.{ts,tsx}",
				"tests/**/*.ts"
			],
			"ignoreDependencies": [
				"tailwindcss"
			]
		},
		"apps/site": {
			"entry": [
				"src/app/**/*.{ts,tsx}",
				"tests/**/*.test.ts"
			],
			"project": [
				"src/**/*.{ts,tsx}",
				"tests/**/*.ts"
			],
			"ignoreDependencies": [
				"tailwindcss"
			]
		},
		"apps/bench": {
			"project": [
				"src/**/*.{ts,svelte}"
			]
		},
		"packages/shared": {
			"entry": [
				"tests/**/*.test.ts"
			],
			"project": [
				"src/**/*.ts",
				"tests/**/*.ts"
			]
		},
		"packages/ui": {
			"project": [
				"src/**/*.{ts,tsx}"
			],
			"ignoreDependencies": [
				"@fontsource/geist-mono",
				"@fontsource/inter",
				"@fontsource/lora"
			]
		}
	}
}

# Local dev for @recoder/server. Compose passes these explicitly; see root .env.example.
PORT=3001
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
GITHUB_WEBHOOK_SECRET=
RECODER_ALLOWED_COMMANDS=echo,git,gh,bun
RECODER_WORKDIR=/tmp/recoder-work
RECODER_COMMAND_TIMEOUT_MS=120000
# OAuth application client ids for "Continue with GitHub/GitLab" (device flow). Blank turns that sign-in off.
RECODER_GITHUB_CLIENT_ID=
RECODER_GITLAB_CLIENT_ID=

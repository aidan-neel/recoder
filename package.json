{
	"name": "recoder",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev --filter=@recoder/server --filter=@recoder/app",
		"dev:all": "turbo dev",
		"dev:web": "turbo dev --filter=@recoder/server --filter=@recoder/web",
		"dev:server": "bun --filter @recoder/server dev",
		"dev:app": "bun --filter @recoder/app dev",
		"build": "turbo build",
		"check": "turbo check",
		"test": "turbo test",
		"lint": "turbo lint",
		"deadcode": "knip && jscpd",
		"dev:site": "bun --filter @recoder/site dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "16.4.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jscpd": "^5.4.0",
		"knip": "^6.39.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"turbo": "^2.10.12",
		"typescript-eslint": "^8.71.0"
	}
}

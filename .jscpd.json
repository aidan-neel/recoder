{
	"path": ["apps", "packages"],
	"ignore": [
		"**/node_modules/**",
		"**/.svelte-kit/**",
		"**/.next/**",
		"**/next-env.d.ts",
		"**/public/**",
		"**/build/**",
		"**/dist/**",
		"**/static/**",
		"**/*.html",
		"**/*.css",
		"**/package.json"
	],
	"threshold": 0,
	"reporters": ["console"],
	"gitignore": true
}

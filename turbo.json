{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", "dist/**"],
			"outputLogs": "errors-only"
		},
		"check": {
			"dependsOn": ["^build"],
			"outputLogs": "errors-only"
		},
		"test": {
			"dependsOn": ["^build"],
			"outputLogs": "errors-only"
		},
		"@recoder/server#test:ha": {
			"dependsOn": ["^build"],
			"env": ["TEST_DATABASE_URL", "RECODER_POSTGRES_TEST_URL"],
			"outputLogs": "errors-only"
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"@recoder/web#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/px-to-rem.ts"],
			"outputs": ["build/**", "dist/**"],
			"outputLogs": "errors-only"
		},
		"@recoder/site#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/ui/px-to-rem.ts",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/apps/app/src/**"
			],
			"outputs": ["!.next/cache/**", ".next/**"],
			"outputLogs": "errors-only"
		},
		"@recoder/site#check": {
			"dependsOn": ["^build", "build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/**", "$TURBO_ROOT$/apps/app/src/**"],
			"outputLogs": "errors-only"
		},
		"@recoder/site#test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/**", "$TURBO_ROOT$/apps/app/src/**"],
			"outputLogs": "errors-only"
		},
		"@recoder/app#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/px-to-rem.ts", "$TURBO_ROOT$/packages/ui/src/**"],
			"outputs": ["!.next/cache/**", ".next/**"],
			"outputLogs": "errors-only"
		},
		"@recoder/app#check": {
			"dependsOn": ["^build", "build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/**"],
			"outputLogs": "errors-only"
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/eslint.config.js",
				"$TURBO_ROOT$/.prettierrc.json",
				"$TURBO_ROOT$/.prettierignore"
			],
			"outputLogs": "errors-only"
		},
		"//#deadcode": {
			"outputLogs": "errors-only"
		}
	}
}

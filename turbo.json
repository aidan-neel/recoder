{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", "dist/**"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"@recoder/site#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"],
			"outputs": ["build/**", ".vercel/output/**"]
		},
		"@recoder/site#check": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"]
		},
		"@recoder/bench#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/apps/web/src/**",
				"$TURBO_ROOT$/apps/web/static/**",
				"$TURBO_ROOT$/apps/server/src/**"
			],
			"outputs": ["build/**"]
		},
		"@recoder/bench#check": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**", "$TURBO_ROOT$/apps/server/src/**"]
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/eslint.config.js",
				"$TURBO_ROOT$/.prettierrc.json",
				"$TURBO_ROOT$/.prettierignore"
			]
		}
	}
}

# --- Recoder self-hosted configuration -------------------------------------
# Copy to `.env` for `docker compose up`. Values here are the compose defaults.

# API base URL reachable from the *browser* (baked into the web image as a build arg)
PUBLIC_API_URL=http://localhost:3001

# Public URL of the web app (used for CORS-adjacent links + webhook payloads)
FRONTEND_URL=http://localhost:3000

# --- Server ------------------------------------------------------------------
PORT=3001
GITHUB_WEBHOOK_SECRET=
# Token for the gh CLI (PR fetch + private clones). Public repos work without it.
# The git CLI picks up host credentials (`gh auth setup-git`) for private clones;
# tokens are never embedded in URLs (they would leak into command-run logs).
GITHUB_TOKEN=
# Same for glab (or connect from the UI — tokens stay in server memory).
GITLAB_TOKEN=
# Self-managed GitLab host, e.g. gitlab.dev.acme.com (default: gitlab.com).
GITLAB_HOST=
# Where the server persists UI-connected tokens (0600). Mount as a volume.
RECODER_DATA_DIR=./data
# Reviewer model routing (OpenAI-compatible: vLLM, OpenRouter, DashScope).
# Example for Qwen via OpenRouter:
#   RECODER_REVIEW_BASE_URL=https://openrouter.ai/api/v1
#   RECODER_REVIEW_API_KEY=sk-or-...
#   RECODER_REVIEW_MODEL=qwen/qwen-2.5-coder-32b-instruct
RECODER_REVIEW_BASE_URL=
RECODER_REVIEW_API_KEY=
RECODER_REVIEW_MODEL=
# Optional per-role overrides (default: RECODER_REVIEW_MODEL).
RECODER_SECURITY_MODEL=
RECODER_PERF_MODEL=
RECODER_CORRECTNESS_MODEL=
RECODER_DOCS_MODEL=
# Caps per review.
RECODER_REVIEW_MAX_FILES=20
RECODER_REVIEW_MAX_DIFF_CHARS=60000
RECODER_REVIEW_MAX_FILE_CHARS=12000
# Binaries the command runner is allowed to execute (no shell, argv only)
RECODER_ALLOWED_COMMANDS=echo,git,gh,bun
RECODER_WORKDIR=/tmp/recoder-work
RECODER_COMMAND_TIMEOUT_MS=120000

# --- Recoder self-hosted configuration -------------------------------------
# Copy to `.env` for `docker compose up`. Values here are the compose defaults.

# API base URL reachable from the *browser* (built into the app image as a build arg)
PUBLIC_API_URL=http://localhost:3001

# Public URL of the web app (used for CORS-adjacent links + webhook payloads)
FRONTEND_URL=http://localhost:3000

# --- Server ------------------------------------------------------------------
PORT=3001
# Key that seals every credential the server saves (tokens, API keys, refresh tokens): 32 random bytes as base64.
# Make one with `openssl rand -base64 32`. Required with RECODER_DATABASE_URL, so every replica opens the same
# values. Unset on a single server, a key is made on first start in ~/.config/recoder/secret.key (or
# $XDG_CONFIG_HOME/recoder/secret.key), outside the data folder. Supply it through a secret; docs/review/configuration.md.
# RECODER_SECRET_KEY=
# Optional shared PostgreSQL storage for API replicas. Supply the URL through a secret.
# RECODER_DATABASE_URL=postgresql://recoder@postgres.example.org/recoder?sslmode=verify-full
# RECODER_INSTANCE_ID=recoder-api-1
# RECODER_JOB_LEASE_MS=30000
# RECODER_JOB_POLL_MS=250
# Reviews this replica runs at once; 0 makes an API-only replica.
# RECODER_JOB_CONCURRENCY=2
GITHUB_WEBHOOK_SECRET=
# Secret token of the GitLab webhook (docs/auto-review.md). Unset accepts any caller.
GITLAB_WEBHOOK_SECRET=
# OAuth application client ids for "Continue with GitHub/GitLab". Blank turns that sign-in off. With only the id a
# forge signs in by device code; with the secret too it redirects to the forge and back (docs/review/configuration.md).
RECODER_GITHUB_CLIENT_ID=
RECODER_GITLAB_CLIENT_ID=
RECODER_GITHUB_CLIENT_SECRET=
RECODER_GITLAB_CLIENT_SECRET=
# The address people reach the API at, when a proxy hides it from the request. Sets the OAuth callback address.
# RECODER_PUBLIC_URL=https://recoder.example.ts.net
# Token for the gh CLI (PR fetch + private clones). Public repos work without it.
# The git CLI picks up host credentials (`gh auth setup-git`) for private clones;
# tokens are never embedded in URLs (they would leak into command-run logs).
GITHUB_TOKEN=
# Same for glab (or connect from the UI — saved tokens are sealed with RECODER_SECRET_KEY).
GITLAB_TOKEN=
# Self-managed GitLab host, e.g. gitlab.dev.acme.com (default: gitlab.com).
GITLAB_HOST=
# Where the server persists settings and UI-connected tokens (sealed, 0600). Mount as a volume.
RECODER_DATA_DIR=./data
# Reviewer model routing (OpenAI-compatible: vLLM, OpenRouter, DashScope).
# Example for Qwen via OpenRouter:
#   RECODER_REVIEW_BASE_URL=https://openrouter.ai/api/v1
#   RECODER_REVIEW_API_KEY=sk-or-...
#   RECODER_REVIEW_MODEL=qwen/qwen-2.5-coder-32b-instruct
RECODER_REVIEW_BASE_URL=
RECODER_REVIEW_API_KEY=
RECODER_REVIEW_MODEL=
# Optional per-role overrides (default: RECODER_REVIEW_MODEL).
RECODER_SECURITY_MODEL=
RECODER_PERF_MODEL=
RECODER_CORRECTNESS_MODEL=
RECODER_DOCS_MODEL=
# Caps per review.
RECODER_REVIEW_MAX_FILES=200
RECODER_REVIEW_MAX_DIFF_CHARS=600000
RECODER_REVIEW_MAX_FILE_CHARS=12000
# Binaries the command runner is allowed to execute (no shell, argv only)
RECODER_ALLOWED_COMMANDS=echo,git,gh,bun
RECODER_WORKDIR=/tmp/recoder-work
RECODER_COMMAND_TIMEOUT_MS=120000

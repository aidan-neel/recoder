# --- Recoder self-hosted configuration -------------------------------------
# Copy to `.env` for `docker compose up`. Values here are the compose defaults.

# API base URL reachable from the *browser* (baked into the web image as a build arg)
PUBLIC_API_URL=http://localhost:3001

# Public URL of the web app (used for CORS-adjacent links + webhook payloads)
FRONTEND_URL=http://localhost:3000

# --- Server ------------------------------------------------------------------
PORT=3001
GITHUB_WEBHOOK_SECRET=
# Binaries the command runner is allowed to execute (no shell, argv only)
RECODER_ALLOWED_COMMANDS=echo,git,gh,bun
RECODER_WORKDIR=/tmp/recoder-work
RECODER_COMMAND_TIMEOUT_MS=120000

{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"required": ["server", "app", "imagePullSecrets"],
	"properties": {
		"imagePullSecrets": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name"],
				"properties": { "name": { "$ref": "#/definitions/name" } }
			}
		},
		"server": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"image",
				"frontendUrl",
				"existingSecret",
				"env",
				"resources",
				"workSizeLimit",
				"tmpSizeLimit",
				"persistence",
				"replicaCount",
				"database",
				"dataSizeLimit"
			],
			"properties": {
				"image": { "$ref": "#/definitions/image" },
				"frontendUrl": { "type": "string", "pattern": "^https?://[^/ ]+(/[^ ]*)?$" },
				"existingSecret": { "type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
				"env": {
					"type": "object",
					"propertyNames": {
						"pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
						"not": {
							"enum": [
								"PORT",
								"HOST",
								"HOME",
								"FRONTEND_URL",
								"RECODER_DATA_DIR",
								"RECODER_WORKDIR",
								"RECODER_DATABASE_URL"
							]
						}
					},
					"additionalProperties": { "type": "string" }
				},
				"resources": { "$ref": "#/definitions/resources" },
				"workSizeLimit": { "$ref": "#/definitions/quantity" },
				"tmpSizeLimit": { "$ref": "#/definitions/quantity" },
				"persistence": {
					"type": "object",
					"additionalProperties": false,
					"required": ["existingClaim", "size"],
					"properties": {
						"existingClaim": { "type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
						"storageClass": { "type": ["string", "null"] },
						"size": { "$ref": "#/definitions/quantity" }
					}
				},
				"replicaCount": { "type": "integer", "minimum": 1, "maximum": 32 },
				"database": {
					"type": "object",
					"additionalProperties": false,
					"required": ["existingSecret", "secretKey"],
					"properties": {
						"existingSecret": { "type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
						"secretKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$" }
					}
				},
				"dataSizeLimit": { "$ref": "#/definitions/quantity" }
			},
			"allOf": [
				{
					"if": { "properties": { "replicaCount": { "minimum": 2 } } },
					"then": { "properties": { "database": { "properties": { "existingSecret": { "minLength": 1 } } } } }
				},
				{
					"if": { "properties": { "database": { "properties": { "existingSecret": { "minLength": 1 } } } } },
					"then": { "properties": { "persistence": { "properties": { "existingClaim": { "const": "" } } } } }
				}
			]
		},
		"app": {
			"type": "object",
			"additionalProperties": false,
			"required": ["image", "resources", "tmpSizeLimit", "replicaCount"],
			"properties": {
				"image": { "$ref": "#/definitions/image" },
				"resources": { "$ref": "#/definitions/resources" },
				"tmpSizeLimit": { "$ref": "#/definitions/quantity" },
				"replicaCount": { "type": "integer", "minimum": 1, "maximum": 32 }
			}
		}
	},
	"definitions": {
		"name": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
		"quantity": { "type": "string", "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)([EPTGMK]i?|m)?$" },
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "tag", "pullPolicy"],
			"properties": {
				"repository": { "type": "string", "minLength": 1, "pattern": "^[^ @]+$" },
				"tag": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
				"pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
			}
		},
		"resources": {
			"type": "object",
			"additionalProperties": false,
			"required": ["requests", "limits"],
			"properties": {
				"requests": { "$ref": "#/definitions/resourceList" },
				"limits": { "$ref": "#/definitions/resourceList" }
			}
		},
		"resourceList": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cpu", "memory"],
			"properties": {
				"cpu": { "$ref": "#/definitions/quantity" },
				"memory": { "$ref": "#/definitions/quantity" },
				"ephemeral-storage": { "$ref": "#/definitions/quantity" }
			}
		}
	}
}
